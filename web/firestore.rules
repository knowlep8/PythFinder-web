rules_version = '2';

// Saved runs, self-declared name only -- there is no login on this site at
// all (docs/web-planner.md: the team has no email between them to
// authenticate with). Open by design: the point is stopping Jake
// absent-mindedly saving over Amy's run_a, not keeping anyone out. Anyone
// who reads or writes here can read or write anyone else's runs too, on
// purpose, and that is an accepted tradeoff, not an oversight.
service cloud.firestore {
  match /databases/{database}/documents {
    match /runs/{owner}/items/{name} {
      allow read, write: if true;
    }

    // The "all saved runs" mentor view runs a collection-group query across
    // every owner's items subcollection. Firestore requires its own rule for
    // that shape even though the path rule above already allows it directly.
    match /{path=**}/items/{name} {
      allow read: if true;
    }

    // Robot profiles and start positions, step 5.3 -- team-wide rather than
    // per-owner like runs above, since the team shares one robot and one set
    // of launch areas. Same open-by-design rule: nothing here is sensitive,
    // and the team has no login to gate it with anyway.
    match /robots/{name} {
      allow read, write: if true;
    }

    match /starts/{name} {
      allow read, write: if true;
    }
  }
}
