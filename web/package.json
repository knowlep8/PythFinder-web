{
  "name": "pythfinder-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plan an FLL run in a browser and download the file the hub runs",
  "scripts": {
    "copy:pyodide": "node scripts/copy-pyodide.mjs",
    "copy:assets": "node scripts/copy-assets.mjs",
    "predev": "npm run copy:pyodide && npm run copy:assets",
    "dev": "vite",
    "prebuild": "npm run copy:pyodide && npm run copy:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.2",
    "firebase": "^12.19.0",
    "pyodide": "^0.28.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
