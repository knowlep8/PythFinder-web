{
  "name": "pythfinder-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plan an FLL run in a browser and download the file the hub runs",
  "scripts": {
    "copy:pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "npm run copy:pyodide",
    "dev": "vite",
    "prebuild": "npm run copy:pyodide",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "pyodide": "^0.28.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
